# Variáveis de ambiente do VagaON. Cópia comentada, valor por valor, em
# docs/VARIAVEIS.md. Com o site rodando, /admin/diagnostico mostra o que já
# está definido neste ambiente e o que cada ausência desliga.

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/vagaon"

# NextAuth v5
AUTH_SECRET="<gerar com: openssl rand -base64 32>"
AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"   # descomentar na Vercel (produção)

# Cloudinary (upload de fotos e logos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Notificações (todos opcionais: canal sem credencial é ignorado) ─────────
# A notificação in-app (sino no Navbar) funciona sempre, sem nada disto.

# Push (PWA) — gere o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com.br"
# NEXT_PUBLIC_SW_EM_DEV="1"   # registra o service worker em dev, para testar push

# E-mail (Resend, https://resend.com). Sem EMAIL_REMETENTE usa onboarding@resend.dev,
# que só entrega para o e-mail da própria conta — bom para testar antes de verificar o domínio.
RESEND_API_KEY=""
EMAIL_REMETENTE="VagaON <avisos@seudominio.com.br>"

# WhatsApp (API oficial da Meta / Cloud API). Ver docs/NOTIFICACOES.md para o template.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="vagaon_aviso"
# WHATSAPP_API_VERSION="v21.0"   # só para fixar outra versão da Cloud API

# Cron da Vercel (lembrete de entrevista, 09:00 BRT). Gere com: openssl rand -hex 32
CRON_SECRET=""

# IA (currículo → perfil, frase → vaga, resumo de triagem). Chave em console.anthropic.com.
# Sem a chave, os botões de IA ficam ocultos e todo o resto funciona normalmente.
ANTHROPIC_API_KEY=""

# Planos para empresas (ver docs/PLANOS.md). Vazio ou diferente de "1": toda
# empresa é tratada como Pro e nada é limitado. Antes de ligar, rode
# node src/scripts/conceder-trial.mjs --dias 60 para a base atual.
PLANOS_ATIVOS=""

# Integração RedeSA (entrada por token e webhook de talentos). Sem isto, a
# integração fica desligada e o VagaON funciona sozinho normalmente.
CROSS_PLATFORM_SECRET=""
